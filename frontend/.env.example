# ---------------------------------------------------------------------------
# Frontend runtime config (Vite only exposes variables prefixed with VITE_).
# Copy to `.env.local` and adjust. Secrets must NEVER live here — API keys
# belong to the backend (`backend/.env`) so they never reach the WebView.
# ---------------------------------------------------------------------------

# Fixed dev port of the Python backend (must match backend/.env SVA_PORT).
VITE_BACKEND_PORT=8756

# Backend host. Loopback only — the engine must never listen on 0.0.0.0.
VITE_BACKEND_HOST=127.0.0.1

# HTTP request timeout in ms for long jobs (kept short; real work is async).
VITE_API_TIMEOUT_MS=30000
