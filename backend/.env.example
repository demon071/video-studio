# ---------------------------------------------------------------------------
# ShortVideoAI — Python engine environment
# Copy to `backend/.env`. Never commit this file.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Loopback-only port. Must match frontend/.env.local VITE_BACKEND_PORT.
SVA_PORT=8756
SVA_HOST=127.0.0.1
SVA_LOG_LEVEL=INFO
# Set by the Tauri sidecar supervisor; "1" makes the process exit if the
# parent desktop app dies (orphan protection).
SVA_PACKAGED=0
SVA_PARENT_PID=

# --- Storage ---------------------------------------------------------------
# Leave empty to use %APPDATA%\ShortVideoAI (models, cache, projects, logs).
SVA_DATA_DIR=
# Optional explicit FFmpeg binary directory (bundle or winget install).
SVA_FFMPEG_DIR=
# Where the Models panel downloads the AI pack from (the full engine, ~1.8 GB
# zip). Leave empty to install the pack from a local .zip the user picked.
SVA_AI_PACK_URL=

# --- Hardware --------------------------------------------------------------
# auto | cuda | cpu | directml. `auto` probes torch.cuda first, then CPU.
SVA_DEVICE=auto
# Compute plan: max = medium Whisper fp16 + Qwen offloaded (4 GB+ NVIDIA),
#                safe = small Whisper fp16, LLM on CPU,
#                cpu  = everything on the CPU.
SVA_GPU_PRESET=max
# Headroom kept free on the GPU before a stage is allowed to use it.
SVA_VRAM_RESERVE_GB=0.8
# GPU stages are serialised; raise only on cards with 8 GB+.
SVA_MAX_CONCURRENT_JOBS=1
# Whisper model auto-selected from the preset when left empty.
SVA_WHISPER_MODEL=
SVA_WHISPER_COMPUTE_TYPE=
# Number of CPU threads reserved for AI work (0 = let the runtime decide).
SVA_CPU_THREADS=0

# --- Pipeline defaults -----------------------------------------------------
# stt:       local | sensevoice | groq | openai | capcut | bilibili | ocr
# translate: local | gemini | openai | google | bing
# tts:       capcut | omnivoice | voicestudio
SVA_STT_PROVIDER=local
SVA_TRANSLATE_PROVIDER=local
SVA_TTS_PROVIDER=capcut
SVA_SOURCE_LANGUAGE=auto
SVA_TARGET_LANGUAGE=vi
# Hard cap for the atempo speed-up ratio (voice stays natural above 1.0).
SVA_MAX_TEMPO_RATIO=1.35

# --- Models ----------------------------------------------------------------
# Filename inside %APPDATA%\ShortVideoAI\models\llm (Models panel downloads it).
SVA_LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
SVA_LLM_CONTEXT=8192
# -1 = offload every layer the free VRAM allows.
SVA_LLM_GPU_LAYERS=-1
SVA_GEMINI_MODEL=gemini-2.5-flash
SVA_OPENAI_CHAT_MODEL=gpt-4.1-mini
SVA_GROQ_STT_MODEL=whisper-large-v3-turbo
SVA_OPENAI_STT_MODEL=whisper-1

# --- TTS -------------------------------------------------------------------
# CapCut (cloud, default): the voice *type* key from capcut_client.CAPCUT_VOICES.
SVA_CAPCUT_VOICE=BV421_vivn_streaming
# Speaking rate, CapCut only (SSML prosody).
SVA_TTS_RATE=+0%
# OmniVoice (k2-fsa, in-process torch, `pip install omnivoice`). The weights sit
# in %APPDATA%\ShortVideoAI\models\tts\omnivoice-v1 (3.3 GB) and a fresh machine
# fetches them on the first dubbed line. The voice box in the AI panel takes
# `auto`, `design:<attributes>` or `clone:<3-10 s wav>`:
SVA_OMNIVOICE_MODEL=k2-fsa/OmniVoice
# auto | cuda | cpu
SVA_OMNIVOICE_DEVICE=auto
# Diffusion steps, 4-64 (32 = published default; 16 is the fast take).
SVA_OMNIVOICE_STEPS=32
# Language tag for generate(): it makes the model read Vietnamese instead of guessing.
SVA_OMNIVOICE_LANGUAGE=vi
SVA_OMNIVOICE_VOICE=auto
# Transcript of the clone sample; empty = the model transcribes it itself.
SVA_OMNIVOICE_REFERENCE_TEXT=
# VoiceStudio (github.com/debpalash/voicestudio): OpenAI-compatible local server.
SVA_VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
SVA_VOICESTUDIO_MODEL=tts-1
SVA_VOICESTUDIO_VOICE=alloy
# Only for a Docker/remote server started with OMNIVOICE_API_KEY.
SVA_VOICESTUDIO_API_KEY=

# --- OCR subtitle extraction (provider=ocr) --------------------------------
# Engine order: SVA_OCR_ENGINE first, then the other installed ones.
SVA_OCR_ENGINE=rapidocr
# 3 fps keeps sub-second cues; drop to 2 for slow dialogue (40% faster).
SVA_OCR_FPS=3.0
# The band is the share of the frame height that is read, counted up from the
# bottom edge. 0.45 leaves room for the accents above the first line.
SVA_OCR_POSITION=bottom
SVA_OCR_BAND=0.45
# auto = Chinese hardsubs; vi/en/ja/ko select the matching recogniser.
SVA_OCR_LANGUAGE=auto

# --- Render ----------------------------------------------------------------
SVA_RENDER_CRF=20
SVA_RENDER_PRESET=medium
SVA_SUBTITLE_FONT=Arial
SVA_SUBTITLE_FONT_SIZE=18

# --- Online providers (optional; only used when provider=api) --------------
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- HuggingFace -----------------------------------------------------------
# Optional token: raises download rate limits for large model files.
HF_TOKEN=
HF_HOME=
